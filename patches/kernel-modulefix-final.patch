+LZ4_FORCE_INLINE void LZ4_putPosition(const BYTE *p, void *tableBase,
+				      tableType_t tableType)
+{
+	U32 const h = LZ4_hashPosition(p, tableType);
+	LZ4_putPositionOnHash(p, h, tableBase, tableType);
+}

+			/* copy match within block */
+			cpy = op + length;
+
+			/* partialDecoding : may end anywhere within the block */
+			assert(op <= oend);
+			if (partialDecoding &&
+			    (cpy > oend - MATCH_SAFEGUARD_DISTANCE)) {
+				size_t const mlen =
+					MIN(length, (size_t)(oend - op));

diff --git a/drivers/block/zram/backend_lz4kd.c b/drivers/block/zram/backend_lz4kd.c
new file mode 100644
index 0000000..2fa6d38
--- /dev/null
+++ b/drivers/block/zram/backend_lz4kd.c
@@ -0,0 +1,147 @@
+#include <linux/kernel.h>
+#include <linux/slab.h>
+#include <linux/vmalloc.h>
+#include <linux/module.h>
+
+#include <linux/lz4.h>
+
+#include "backend_lz4kd.h"
+
+#define LZ4K_ACCELERATION	3
+#define LZ4KD_ACCELERATION	5
+
+struct lz4k_ctx {
+	void *mem;
+};
+
+/* 参数设置与释放 */
+static void lz4k_release_params(struct zcomp_params *params)
+{
+}
+
+static int lz4k_setup_params(struct zcomp_params *params)
+{
+	if (params->level == ZCOMP_PARAM_NO_LEVEL)
+		params->level = 0;
+	return 0;
+}
+
+static void lz4k_destroy(struct zcomp_ctx *ctx)
+{
+	struct lz4k_ctx *zctx = ctx->context;
+
+	if (!zctx)
+		return;
+
+	vfree(zctx->mem);
+	kfree(zctx);
+}
+
+static int lz4k_create(struct zcomp_params *params, struct zcomp_ctx *ctx)
+{
+	struct lz4k_ctx *zctx;
+
+	zctx = kzalloc(sizeof(*zctx), GFP_KERNEL);
+	if (!zctx)
+		return -ENOMEM;
+
+	ctx->context = zctx;
+
+	zctx->mem = vmalloc(LZ4_MEM_COMPRESS);
+	if (!zctx->mem)
+		goto error;
+
+	return 0;
+
+error:
+	lz4k_destroy(ctx);
+	return -ENOMEM;
+}
+
+/* ================= LZ4K Backend ================= */
+
+#ifdef CONFIG_ZRAM_BACKEND_LZ4K
+static int lz4k_compress(struct zcomp_params *params, struct zcomp_ctx *ctx,
+			struct zcomp_req *req)
+{
+	struct lz4k_ctx *zctx = ctx->context;
+	int ret;
+
+	ret = LZ4_compress_fast(req->src, req->dst, req->src_len,
+				req->dst_len, LZ4K_ACCELERATION, zctx->mem);
+	
+	if (!ret)
+		return -EINVAL;
+	
+	req->dst_len = ret;
+	return 0;
+}
+
+static int lz4k_decompress(struct zcomp_params *params, struct zcomp_ctx *ctx,
+			  struct zcomp_req *req)
+{
+	int ret;
+
+	ret = LZ4_decompress_safe(req->src, req->dst, req->src_len,
+				  req->dst_len);
+	
+	if (ret < 0)
+		return -EINVAL;
+	
+	return 0;
+}
+
+const struct zcomp_ops backend_lz4k = {
+	.compress	= lz4k_compress,
+	.decompress	= lz4k_decompress,
+	.create_ctx	= lz4k_create,
+	.destroy_ctx	= lz4k_destroy,
+	.setup_params	= lz4k_setup_params,
+	.release_params	= lz4k_release_params,
+	.name		= "lz4k",
+};
+#endif
+
+/* ================= LZ4KD Backend ================= */
+
+#ifdef CONFIG_ZRAM_BACKEND_LZ4KD
+static int lz4kd_compress(struct zcomp_params *params, struct zcomp_ctx *ctx,
+			struct zcomp_req *req)
+{
+	struct lz4k_ctx *zctx = ctx->context;
+	int ret;
+
+	ret = LZ4_compress_fast(req->src, req->dst, req->src_len,
+				req->dst_len, LZ4KD_ACCELERATION, zctx->mem);
+	
+	if (!ret)
+		return -EINVAL;
+	
+	req->dst_len = ret;
+	return 0;
+}
+
+static int lz4kd_decompress(struct zcomp_params *params, struct zcomp_ctx *ctx,
+			  struct zcomp_req *req)
+{
+	int ret;
+
+	ret = LZ4_decompress_safe(req->src, req->dst, req->src_len,
+				  req->dst_len);
+	
+	if (ret < 0)
+		return -EINVAL;
+	
+	return 0;
+}
+
+const struct zcomp_ops backend_lz4kd = {
+	.compress	= lz4kd_compress,
+	.decompress	= lz4kd_decompress,
+	.create_ctx	= lz4k_create,
+	.destroy_ctx	= lz4k_destroy,
+	.setup_params	= lz4k_setup_params,
+	.release_params	= lz4k_release_params,
+	.name		= "lz4kd",
+};
+#endif

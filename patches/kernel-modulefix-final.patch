+
+  \param[in] out_max
+    !=0, size in bytes of the output buffer at *out
+ */
+int lz4k_decode_delta(
+	const void *in,
+	const void *const out0,
+	void *const out,
+	unsigned in_max,
+	unsigned out_max);
+
+
+#endif /* _LZ4K_H */
